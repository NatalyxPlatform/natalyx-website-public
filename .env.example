# Copy to .env.local for development. Never commit real values.

# ---------------------------------------------------------------------------
# Public (inlined into the client bundle - nothing secret belongs here)
# ---------------------------------------------------------------------------

# Base URL used for canonical and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://natalyx.health

# Target of the footer "Developer access" link.
NEXT_PUBLIC_DEVELOPER_ACCESS_URL=https://dev.app.natalyx.health/login

# ---------------------------------------------------------------------------
# Clinic-interest lead delivery (server only)
# ---------------------------------------------------------------------------
# POST /api/clinic-interest delivers to every configured channel and succeeds
# if at least one accepts the lead. With nothing configured it answers 500 and
# the form shows an error: a lead that went nowhere is never reported as sent.
#
# These are read on the server only. Do not prefix any of them with
# NEXT_PUBLIC_ - that would publish them in the browser bundle.

# Channel 1 - Supabase. Both variables are required together. Inserts into
# marketing_private.clinic_interest_leads (see supabase/migrations).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Channel 2 - Web3Forms email delivery.
# NOTE: this replaces the former NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY, which was
# bundled into the browser with a hard-coded fallback. There is no fallback
# any more, so this must be set in the deployment environment for email
# delivery to run.
WEB3FORMS_ACCESS_KEY=

# Local and preview only - deliver nowhere and write a redacted record to the
# server log instead. Explicit opt-in that overrides the channels above, so a
# real deployment cannot silently fall into it. Used to walk the submission
# path without sending anything to a third party.
# LEAD_DELIVERY_MODE=log
