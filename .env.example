# Copy to .env.local for development. Never commit real values.

# ---------------------------------------------------------------------------
# Public (inlined into the client bundle - nothing secret belongs here)
# ---------------------------------------------------------------------------

# Base URL used for canonical and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://natalyx.health

# Target of the footer "Developer access" link.
NEXT_PUBLIC_DEVELOPER_ACCESS_URL=https://dev.app.natalyx.health/login

# ---------------------------------------------------------------------------
# Clinic-interest lead delivery (server only)
# ---------------------------------------------------------------------------
# Email delivery happens IN THE BROWSER. Web3Forms rejects server-to-server
# calls on the free plan (403 "Use our API in client side"), so the flow is:
#
#   browser -> POST /api/clinic-interest   (validate, rate-limit, honeypot,
#                                           optional Supabase write)
#           -> POST api.web3forms.com      (the actual email, browser-side)
#
# The server composes the payload and hands it back; the browser only relays
# it. The form reports success only once Web3Forms accepts.

# Supabase - OPTIONAL server-side storage alongside the email. Both variables
# are required together. Inserts into marketing_private.clinic_interest_leads
# (see supabase/migrations). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web3Forms email delivery. OPTIONAL - a built-in key ships in the code, so
# this works with no configuration. NEXT_PUBLIC_ is correct: the key must reach
# the browser, and Web3Forms access keys are public by design (they name a
# destination inbox and grant no account access). Set this only to route leads
# to a different inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Local and preview only - record a redacted lead in the server log AND tell
# the browser to forward nothing, so no email is sent. Explicit opt-in. Use it
# for any local or automated testing of the form.
# LEAD_DELIVERY_MODE=log
